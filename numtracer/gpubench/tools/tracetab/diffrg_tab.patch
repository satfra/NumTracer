+#pragma once
+
+// DiFfRG
+#include <DiFfRG/common/kokkos.hh>
+
+// std
+#include <array>
+#include <cstdlib>
+#include <string>
+
+/**
+ * @file tab.hh
+ * @brief Kernels with a per-run coefficient table (kernel_has_tab) and the table the quadrature integrators keep.
+ *
+ * PROTOTYPE (trace tables, numtracer docs/NUMTRACER_TRACE_TABLES_PROBE.md).
+ */
+
+namespace DiFfRG
+{
+  /**
+   * @brief Whether `K` provides a per-run coefficient table.
+   *
+   * Such a kernel declares
+   * - `static constexpr bool has_tab = true` and `static constexpr size_t tab_size` (entries per table node);
+   * - `static constexpr std::array<bool, cdim> tab_ext_mask`: which external axes the table depends on;
+   * - a host function `tab(ctype *out, a...)`, taking kernel()'s parameters, that writes the tab_size entries of a node.
+   *   Its result must not depend on the k-scaled extent of the first (radial) box variable, on any external axis
+   *   left out of tab_ext_mask, or on the trailing arguments: the integrator computes it once per run;
+   * - `kernel_tab(row, stride, a...)` (and `post_tab(P, row, stride, a...)` with kernel_has_pre), returning kernel(a...)
+   *   from the node's entries `row[e * stride]`.
+   */
+  template <class K>
+  inline constexpr bool kernel_has_tab = requires {
+    requires K::has_tab;
+    K::tab_size;
+    K::tab_ext_mask.size();
+  };
+
+  namespace internal
+  {
+    /// The trace table of a kernel_has_tab kernel, plus the map from external grid point to its shape (the external
+    /// indices restricted to tab_ext_mask).
+    template <typename ctype, typename ExecutionSpace> struct TabTable {
+      Kokkos::View<ctype *, typename ExecutionSpace::memory_space> data;
+      Kokkos::View<unsigned *, typename ExecutionSpace::memory_space> shape_of;
+      std::string key;
+      size_t n_loop = 0, n_shape = 0;
+      /// Entry (shape, loop, e) is data[shape_stride * shape + loop_stride * loop + e * entry_stride].
+      size_t shape_stride = 0, loop_stride = 0, entry_stride = 0;
+
+      /// Layout: shapes fastest (default; adjacent threads of a warp walk the external index, which Kokkos iterates
+      /// fastest on GPUs), or loop nodes fastest with DIFFRG_TAB_LAYOUT=loop.
+      static bool loop_fastest()
+      {
+        static const bool on = [] {
+          const char *v = std::getenv("DIFFRG_TAB_LAYOUT");
+          return v != nullptr && std::string(v) == "loop";
+        }();
+        return on;
+      }
+
+      /// Tables are on unless DIFFRG_NO_TAB is set (A/B switch for the prototype).
+      static bool enabled()
+      {
+        static const bool on = std::getenv("DIFFRG_NO_TAB") == nullptr;
+        return on;
+      }
+    };
+  } // namespace internal
+} // namespace DiFfRG
